# Finance AI Configuration
APP_NAME="LiteBooks Finance AI"
APP_ENV="development"
DEBUG=False
API_V1_STR="/api/v1"

# Server
HOST="127.0.0.1"
PORT=8000

# CORS (Frontend Vite dev server default)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database: Uses SQLite locally for zero-config startup, PostgreSQL compatible
DATABASE_URL="sqlite:///./finance_ai.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/finance_ai"

# Storage & Upload Security
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=25

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY to a strong random 32+ character string in production.
# Startup will fail in production if this remains default.
JWT_SECRET_KEY="change-me-to-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (Pluggable: mock, sarvam, groq, gemini, openai)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="mock-financial-v1"

# Sarvam AI Configuration (Dedicated)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b


